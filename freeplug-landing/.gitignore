# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep .env.example committable
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# backups and copies of env files (e.g. .env.local.owen-backup-20260924-2051), round 4
.env.*
.env*.backup*
.env*.bak*
.env*.orig
*.env.backup*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local agent backups
.owen-backup-*/
.arkitect/

# Cloudflare (OpenNext + Wrangler) build output and local secrets. Keep .dev.vars.example.
/.open-next/
/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
