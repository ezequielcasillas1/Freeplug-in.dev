# After editing .env.local, save to disk — Next.js only reads saved files.

# Public site URL (no trailing slash) — used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/apikeys
# Secret key only: must start with sk_test_ or sk_live_ (not pk_, not mk_, not price IDs)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — must start with whsec_ (Dashboard webhooks or `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...
