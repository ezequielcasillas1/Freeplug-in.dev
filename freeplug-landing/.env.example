# After editing .env.local, save to disk — Next.js only reads saved files.

# Public site URL (no trailing slash) — used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/apikeys
# Secret key only: must start with sk_test_ or sk_live_ (not pk_, not mk_, not price IDs)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — must start with whsec_ (Dashboard webhooks or `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — never expose as NEXT_PUBLIC_*. Used for webhooks and trusted server updates (RLS bypass).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: allow /admin in production (default off). Dev: /admin only on localhost.
# ADMIN_ROUTE_ENABLED=true

# Optional: admin Customers table can set cumulative website value paid (QA / milestone UI tests).
# Off by default. Does not insert billing_ledger rows or call Stripe.
# ADMIN_ALLOW_ADJUST_CUMULATIVE_PAID=true

# Optional: admin “Send via SMTP” (Namecheap Private Email)
# Outgoing: mail.privateemail.com:465 SSL/TLS — same username/password as the mailbox.
# Copy these into .env.local and set SMTP_PASS to the mailbox password (do not commit).
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=465
# SMTP_USER=support@freeplug-in.dev
# SMTP_PASS=your-private-email-mailbox-password
# SMTP_FROM=Freeplug Support <support@freeplug-in.dev>
#
# (Port 587 + STARTTLS also works with many providers; this app defaults secure=true when PORT=465.)
#
# If send fails with "self-signed certificate in certificate chain", a local antivirus/proxy may be
# intercepting TLS. For localhost debugging only you may set:
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# Remove that in production, or fix the machine trust store / disable SSL scanning for SMTP.
#
# 535 / "authentication failed": wrong SMTP_USER or SMTP_PASS. Use the same login as webmail;
# value must be one line in .env.local with no surrounding quotes unless the password contains # or spaces.

# Stripe Checkout: signed-in users return to /dashboard?checkout=success; guests return to /?checkout=success.
# Set NEXT_PUBLIC_APP_URL in Stripe Dashboard redirect allowlist for production.

# Resend — https://resend.com/api-keys
# Used for transactional emails (welcome, payment receipts, status updates, etc.)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Freeplug.dev <noreply@freeplug.dev>
#
# Note: You must verify your sending domain in Resend dashboard before sending emails.
# For development, you can use Resend's sandbox mode which sends to your own email only.
