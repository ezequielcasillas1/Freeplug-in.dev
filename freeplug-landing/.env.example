# After editing .env.local, save to disk — Next.js only reads saved files.

# Public site URL (no trailing slash) — used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/apikeys
# Secret key only: must start with sk_test_ or sk_live_ (not pk_, not mk_, not price IDs)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — must start with whsec_ (Dashboard webhooks or `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...
# Local e2e stacks only: point the Stripe client at a Stripe stand-in on this machine. Refused
# unless the URL is localhost / 127.0.0.1 / ::1 and STRIPE_SECRET_KEY is a test key (sk_test_).
# Leave unset everywhere else.
STRIPE_LOCAL_MOCK_URL=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — never expose as NEXT_PUBLIC_*. Used for webhooks and trusted server updates (RLS bypass).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: allow /admin in production (default off). Dev: /admin only on localhost.
# ADMIN_ROUTE_ENABLED=true

# Comma-separated admin emails (required for /admin and /api/test-email). Fail closed if unset.
# ADMIN_EMAILS=you@freeplug-in.dev

# Optional: admin Customers table can set cumulative website value paid (QA / milestone UI tests).
# Off by default. Does not insert billing_ledger rows or call Stripe.
# ADMIN_ALLOW_ADJUST_CUMULATIVE_PAID=true

# Outbound email — SMTP (primary). Namecheap Private Email: mail.privateemail.com:465 SSL/TLS,
# same username/password as the mailbox. Used for transactional emails (welcome, receipts,
# status updates, password reset), admin "Send via SMTP", and /api/test-email.
# Set SMTP_PASS in .env.local only (do not commit).
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@freeplug-in.dev
SMTP_PASS=your-private-email-mailbox-password
EMAIL_FROM_NAME="Freeplug"
EMAIL_FROM=support@freeplug-in.dev
# Optional default Reply-To (per-message replyTo, e.g. a customer's address, overrides it):
# EMAIL_REPLY_TO=support@freeplug-in.dev
#
# (Port 587 + SMTP_SECURE=false uses STARTTLS; secure defaults to true when PORT=465.)
#
# If send fails with "self-signed certificate in certificate chain", a local antivirus/proxy may be
# intercepting TLS. For localhost debugging only you may set:
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# Remove that in production, or fix the machine trust store / disable SSL scanning for SMTP.
#
# 535 / "authentication failed": wrong SMTP_USER or SMTP_PASS. Use the same login as webmail;
# value must be one line in .env.local with no surrounding quotes unless the password contains # or spaces.

# Stripe Checkout: signed-in users return to /dashboard?checkout=success; guests return to /?checkout=success.
# Set NEXT_PUBLIC_APP_URL in Stripe Dashboard redirect allowlist for production.

# Resend — OPTIONAL fallback only (used only when SMTP_* is not configured). Not required.
# RESEND_API_KEY=re_...

# Cloudflare Turnstile (outreach preview forms). Dev/test may use Cloudflare's official test keys:
# site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
# Production without TURNSTILE_SECRET_KEY refuses every preview form (fails closed).
# Per-IP rate limits. Without either flag below, every request shares one rate-limit bucket.
# TRUST_NETLIFY_IP_HEADER: set to true ONLY on Netlify, where the edge sets x-nf-client-connection-ip
# from the real connection. Anywhere else a client can send that header, so leave it unset.
TRUST_NETLIFY_IP_HEADER=
# TRUST_PROXY_HEADERS: set to true ONLY if a trusted proxy in front of the app sets X-Forwarded-For
# (otherwise that header is ignored: clients can fake it).
TRUST_PROXY_HEADERS=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
