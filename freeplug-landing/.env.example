# After editing .env.local, save to disk — Next.js only reads saved files.

# Public site URL (no trailing slash) — used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/apikeys
# Secret key only: must start with sk_test_ or sk_live_ (not pk_, not mk_, not price IDs)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — must start with whsec_ (Dashboard webhooks or `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...
# Local e2e stacks only: point the Stripe client at a Stripe stand-in on this machine. Refused
# unless the URL is localhost / 127.0.0.1 / ::1 and STRIPE_SECRET_KEY is a test key (sk_test_).
# Leave unset everywhere else.
STRIPE_LOCAL_MOCK_URL=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — never expose as NEXT_PUBLIC_*. Used for webhooks and trusted server updates (RLS bypass).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: allow /admin in production (default off). Dev: /admin only on localhost.
# ADMIN_ROUTE_ENABLED=true

# Comma-separated admin emails (required for /admin and /api/test-email). Fail closed if unset.
# ADMIN_EMAILS=you@freeplug-in.dev

# Optional: admin Customers table can set cumulative website value paid (QA / milestone UI tests).
# Off by default. Does not insert billing_ledger rows or call Stripe.
# ADMIN_ALLOW_ADJUST_CUMULATIVE_PAID=true

# Outbound email — Resend (the only app sender; nodemailer/SMTP was removed Oct 3, 2026).
# Used for password reset, the Google-only sign-in notice, the cancellation notice, the admin
# "Send email" box and /api/test-email. Without RESEND_API_KEY every app send fails with
# "Email is not configured" (logged) and the password reset falls back to Supabase Auth's mailer
# (resetPasswordForEmail; also after a Resend 4xx/5xx, network error or 8 s timeout). Every fallback logs a
# "[password-reset] FALLBACK" warning and shows on the admin mail banner.
# Set RESEND_API_KEY in .env.local only (do not commit). On Cloudflare: `wrangler versions secret put RESEND_API_KEY`.
# EMAIL_FROM must be on the main domain freeplug-in.dev, verified in Resend (DKIM on freeplug-in.dev;
# send.freeplug-in.dev is only Resend's return path for MX + SPF and never appears in From).
# RESEND_API_KEY=re_...
EMAIL_FROM_NAME="Freeplug"
EMAIL_FROM=no-reply@freeplug-in.dev
# Default From: Freeplug <no-reply@freeplug-in.dev>. Default Reply-To (per-message replyTo overrides it):
# EMAIL_REPLY_TO=support@freeplug-in.dev
#
# Supabase Auth emails (sign-up confirmation, claim "send it again", fallback reset) are NOT sent by
# this app: they use the hosted Supabase project's own email settings (Auth > SMTP Settings).

# Stripe Checkout: signed-in users return to /dashboard?checkout=success; guests return to /?checkout=success.
# Set NEXT_PUBLIC_APP_URL in Stripe Dashboard redirect allowlist for production.

# Cloudflare Turnstile (outreach preview forms). Dev/test may use Cloudflare's official test keys:
# site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
# Production without TURNSTILE_SECRET_KEY refuses every preview form (fails closed).
# Per-IP rate limits. Without the flag below, every request shares one rate-limit bucket.
# TRUST_CF_CONNECTING_IP: set to true ONLY on Cloudflare (a `vars` entry on the production and
# preview Workers in wrangler.jsonc), where the edge sets CF-Connecting-IP from the real connection.
# Anywhere else (next dev, vitest, any other host) a client can send that header, so leave it unset.
# X-Forwarded-For / X-Real-IP are never trusted.
TRUST_CF_CONNECTING_IP=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Envato API (template picker catalog sync). Server-only: read from process.env on the server,
# never NEXT_PUBLIC_*, never logged. Leave empty here; set it in .env.local or as a Worker secret.
ENVATO_API_TOKEN=
