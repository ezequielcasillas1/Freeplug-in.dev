+++ b/freeplug-landing/src/lib/email/templates/edge-cases.test.tsx
@@ -0,0 +1,128 @@
+// @vitest-environment node
+import { readdirSync, readFileSync } from 'node:fs'
+import path from 'node:path'
+import type { ReactElement } from 'react'
+import { render, toPlainText } from '@react-email/components'
+import { describe, expect, it } from 'vitest'
+import { EMAIL_LOCALES } from '../locales'
+import { BillingReminderEmail } from './billing-reminder'
+import { GoogleSignInEmail } from './google-sign-in'
+import { PasswordResetEmail } from './password-reset'
+import { PaymentReceivedEmail } from './payment-received'
+import { RequestStatusUpdateEmail } from './request-status-update'
+import { SubscriptionCancelledEmail } from './subscription-cancelled'
+import { WelcomeEmail } from './welcome'
+
+/**
+ * Template CI (Aria, round 5): every email template the app sends through Resend renders, for every enabled
+ * locale (src/lib/email/locales.ts; English-only today), with edge-case inputs. A template that throws, or
+ * a new template that isn't listed here, fails vitest (and so CI).
+ */
+const LONG = 'A'.repeat(10_000)
+const TEXTS: Record<string, string | undefined> = {
+  missing: undefined,
+  empty: '',
+  blank: '   ',
+  long: LONG,
+  unicode: 'Zoë Ñúñez-Łódź 李小龍 Ærøskøbing',
+  rtl: 'محمد العربي \u200f שלום',
+  emoji: '👩🏽‍💻🔥🏳️‍🌈 ✨',
+  special: `<script>alert("x")</script> & 'q' "dq" \\ \${x} {{x}} <b>bold</b> %s %n`,
+}
+const REQUIRED = Object.fromEntries(Object.entries(TEXTS).map(([k, v]) => [k, v ?? ''])) as Record<string, string>
+const RESET_LINKS = [
+  'https://app.example.test/auth/confirm?token_hash=abc&type=recovery&next=/reset-password',
+  `https://app.example.test/auth/confirm?token_hash=${'f'.repeat(512)}&type=recovery&next=%2Freset-password%3Fa%3D1%26b%3D%3C%3E`,
+]
+
+type Case = { template: string; variant: string; el: () => ReactElement; expectText?: string }
+
+function cases(): Case[] {
+  const out: Case[] = []
+  for (const [variant, name] of Object.entries(TEXTS)) {
+    const req = REQUIRED[variant]
+    out.push({ template: 'welcome', variant, el: () => WelcomeEmail({ userName: name }) })
+    out.push({
+      template: 'payment-received',
+      variant,
+      el: () => PaymentReceivedEmail(
+        variant === 'missing'
+          ? { amount: '$40.00', planName: 'Hosting', paymentDate: 'Oct 3, 2026' }
+          : {
+              userName: name,
+              amount: variant === 'long' ? `$${'9'.repeat(400)}.00` : '$1,000,000.00',
+              planName: req,
+              invoiceNumber: req,
+              paymentDate: req,
+              nextBillingDate: req,
+              totalPaidToDate: req,
+            }
+      ),
+    })
+    for (const newStatus of ['submitted', 'in_review', 'closed'] as const) {
+      out.push({
+        template: 'request-status-update',
+        variant: `${variant}/${newStatus}`,
+        el: () => RequestStatusUpdateEmail(
+          variant === 'missing' ? { businessName: 'Test Co', newStatus } : { userName: name, businessName: req, newStatus, message: req }
+        ),
+      })
+    }
+    out.push({
+      template: 'subscription-cancelled',
+      variant,
+      el: () => SubscriptionCancelledEmail(
+        variant === 'missing' ? { endDate: 'Oct 25, 2026' } : { userName: name, planName: req, endDate: req, totalPaidToDate: req }
+      ),
+    })
+    for (const daysUntilBilling of [0, 1, -1, 365]) {
+      out.push({
+        template: 'billing-reminder',
+        variant: `${variant}/${daysUntilBilling}d`,
+        el: () => BillingReminderEmail({ userName: name, planName: req, amount: req || '$0.00', billingDate: req, daysUntilBilling }),
+      })
+    }
+    for (const [i, resetLink] of RESET_LINKS.entries()) {
+      out.push({
+        template: 'password-reset',
+        variant: `${variant}/link${i}`,
+        el: () => PasswordResetEmail(variant === 'missing' ? { resetLink } : { resetLink, userName: name, expiresIn: req }),
+        expectText: 'reset',
+      })
+    }
+  }
+  out.push({ template: 'google-sign-in', variant: 'default', el: () => GoogleSignInEmail({}) })
+  out.push({ template: 'google-sign-in', variant: 'baseUrl', el: () => GoogleSignInEmail({ baseUrl: 'http://localhost:3000' }) })
+  return out
+}
+
+const COVERED = ['welcome', 'payment-received', 'request-status-update', 'subscription-cancelled', 'billing-reminder', 'password-reset', 'google-sign-in']
+
+describe.each(EMAIL_LOCALES)('every email template renders with edge-case inputs (locale %s)', () => {
+  it.each(cases().map((c) => [`${c.template} [${c.variant}]`, c] as const))('%s', async (_label, c) => {
+    const html = await render(c.el())
+    expect(typeof html).toBe('string')
+    expect(html).toMatch(/<\/html>\s*$/)
+    expect(html).toContain('Freeplug')
+    // User-supplied text is escaped, never live markup.
+    expect(html).not.toContain('<script>alert')
+    expect(html).not.toContain('<b>bold</b>')
+    const text = toPlainText(html)
+    expect(text.trim().length).toBeGreaterThan(20)
+    if (c.expectText) expect(text.toLowerCase()).toContain(c.expectText)
+  })
+})
+
+describe('template coverage', () => {
+  it('every *Email template file in this folder is covered above', () => {
+    const dir = __dirname
+    const files = readdirSync(dir).filter((f) => f.endsWith('.tsx') && !f.includes('.test.') && f !== 'base-layout.tsx')
+    const withEmailExport = files.filter((f) => /export function \w+Email\(/.test(readFileSync(path.join(dir, f), 'utf8')))
+    expect(withEmailExport.map((f) => f.replace(/\.tsx$/, '')).sort()).toEqual([...COVERED].sort())
+  })
+
+  it('the password-reset template keeps the link intact (escaped only as HTML requires)', async () => {
+    const html = await render(PasswordResetEmail({ resetLink: RESET_LINKS[1] }))
+    expect(html).toContain(RESET_LINKS[1].replace(/&/g, '&amp;'))
+  })
+})
diff --git a/freeplug-landing/src/lib/email/webhook-email-ledger.ts b/freeplug-landing/src/lib/email/webhook-email-ledger.ts
new file mode 100644
index 0000000..df6ac66
--- /dev/null
+++ b/freeplug-landing/src/lib/email/webhook-email-ledger.ts
@@ -0,0 +1,112 @@
+import 'server-only'
+import { createAdminClient } from '@/lib/supabase/admin'
+import type { MailResult } from './mailer'
+
+/**
+ * Webhook email ledger (public.email_sends, migration 20261003160000_email_sends.sql).
+ *
+ * Every webhook-driven email goes through sendWebhookEmailOnce(), so a Stripe redelivery after Resend's
+ * 24 h idempotency window, or two deliveries at once, can't send a second copy:
+ *   1. claim  (email_send_claim): INSERT … ON CONFLICT (stripe_event_id, template) DO NOTHING RETURNING id;
+ *      when nothing comes back, one conditional UPDATE re-claims a 'failed' row, or a 'pending' row older
+ *      than 15 minutes (a crash after the claim), and bumps attempts. No row back = skip the send.
+ *   2. send   (the caller's sender; it still passes the Resend idempotency key `<event.id>:<template>`).
+ *   3. finish (email_send_finish): 'sent' + Resend id, or 'failed' + a short PII-free reason.
+ *
+ * Never throws. A claim error (DB down, missing service role) is logged and the email is NOT sent: a
+ * missed notice is better than a duplicate, and the webhook still answers 2xx. No recipient, address
+ * or Resend error text ever reaches the table or these logs.
+ */
+export type WebhookEmailOutcome = 'sent' | 'skipped' | 'claim_error' | 'send_failed'
+
+export type LedgerClaim =
+  | { kind: 'claimed'; id: string; attempts: number }
+  | { kind: 'skip' }
+  | { kind: 'error'; error: string }
+
+const SAFE = /[^a-z0-9_ .:-]/gi
+
+/** A short reason that can't carry personal data: the failure class and HTTP status only. */
+export function ledgerErrorFor(result: Extract<MailResult, { success: false }>): string {
+  const parts: string[] = [result.reason]
+  if (result.status != null) parts.push(String(result.status))
+  return parts.join(' ').replace(SAFE, '').slice(0, 200)
+}
+
+function short(e: unknown): string {
+  const msg = e instanceof Error ? e.name : typeof e === 'object' && e && 'code' in e ? `db ${String((e as { code: unknown }).code)}` : 'error'
+  return msg.replace(SAFE, '').slice(0, 80) || 'error'
+}
+
+export async function claimWebhookEmail(stripeEventId: string, template: string): Promise<LedgerClaim> {
+  try {
+    const { data, error } = await createAdminClient().rpc('email_send_claim', {
+      p_stripe_event_id: stripeEventId,
+      p_template: template,
+    })
+    if (error) return { kind: 'error', error: short(error) }
+    const row = Array.isArray(data) ? (data[0] as { id?: string; attempts?: number } | undefined) : undefined
+    if (!row?.id) return { kind: 'skip' }
+    return { kind: 'claimed', id: row.id, attempts: row.attempts ?? 1 }
+  } catch (e) {
+    return { kind: 'error', error: short(e) }
+  }
+}
+
+export async function finishWebhookEmail(
+  id: string,
+  outcome: { status: 'sent'; resendId: string } | { status: 'failed'; error: string }
+): Promise<boolean> {
+  try {
+    const { data, error } = await createAdminClient().rpc('email_send_finish', {
+      p_id: id,
+      p_status: outcome.status,
+      p_resend_id: outcome.status === 'sent' ? outcome.resendId : null,
+      p_error: outcome.status === 'failed' ? outcome.error.replace(SAFE, '').slice(0, 200) : null,
+    })
+    if (error) {
+      console.error('[email-ledger] could not record the outcome', outcome.status, short(error))
+      return false
+    }
+    return data === true
+  } catch (e) {
+    console.error('[email-ledger] could not record the outcome', outcome.status, short(e))
+    return false
+  }
+}
+
+/**
+ * Claims (stripeEventId, template), runs `send` only when the claim succeeded, and records the outcome.
+ * `label` is for logs (e.g. the subscription id); never pass an email address.
+ */
+export async function sendWebhookEmailOnce(
+  stripeEventId: string,
+  template: string,
+  label: string,
+  send: () => Promise<MailResult>
+): Promise<WebhookEmailOutcome> {
+  const claim = await claimWebhookEmail(stripeEventId, template)
+  if (claim.kind === 'error') {
+    console.error(`[email-ledger] claim failed; not sending: event=${stripeEventId} template=${template} ${label} (${claim.error})`)
+    return 'claim_error'
+  }
+  if (claim.kind === 'skip') {
+    console.info(`[email-ledger] already sent or in progress; skipping: event=${stripeEventId} template=${template} ${label}`)
+    return 'skipped'
+  }
+
+  let result: MailResult
+  try {
+    result = await send()
+  } catch (e) {
+    result = { success: false, reason: 'local_error', error: e instanceof Error ? e.message : 'Unknown error' }
+  }
+  if (result.success) {
+    await finishWebhookEmail(claim.id, { status: 'sent', resendId: result.id })
+    return 'sent'
+  }
+  const reason = ledgerErrorFor(result)
+  await finishWebhookEmail(claim.id, { status: 'failed', error: reason })
+  console.error(`[email-ledger] send failed: event=${stripeEventId} template=${template} ${label} attempt=${claim.attempts} (${reason})`)
+  return 'send_failed'
+}
diff --git a/freeplug-landing/src/lib/rate-limit/event-log.ts b/freeplug-landing/src/lib/rate-limit/event-log.ts
new file mode 100644
index 0000000..e05dd7b
--- /dev/null
+++ b/freeplug-landing/src/lib/rate-limit/event-log.ts
@@ -0,0 +1,33 @@
+import 'server-only'
+import { createAdminClient } from '@/lib/supabase/admin'
+
+/**
+ * Event counter on the shared public.rate_limit_hits table (service role has select/insert; rate_check()
+ * purges rows older than 2 days). Used for the password-reset fallback count on the admin mail banner, so
+ * the count is shared by every Workers isolate without a migration. `label` must not contain personal data.
+ */
+export async function recordEvent(bucket: string, label: string): Promise<{ ok: boolean; error?: string }> {
+  try {
+    const { error } = await createAdminClient().from('rate_limit_hits').insert({ bucket, key_hash: label })
+    return error ? { ok: false, error: error.message } : { ok: true }
+  } catch (e) {
+    return { ok: false, error: e instanceof Error ? e.message : 'unknown error' }
+  }
+}
+
+/** Newest first, at most 1000. Returns null when the database can't be read. */
+export async function listEvents(bucket: string, sinceIso: string): Promise<{ label: string; at: string }[] | null> {
+  try {
+    const { data, error } = await createAdminClient()
+      .from('rate_limit_hits')
+      .select('key_hash, hit_at')
+      .eq('bucket', bucket)
+      .gte('hit_at', sinceIso)
+      .order('hit_at', { ascending: false })
+      .limit(1000)
+    if (error || !Array.isArray(data)) return null
+    return (data as { key_hash: string; hit_at: string }[]).map((r) => ({ label: r.key_hash, at: r.hit_at }))
+  } catch {
+    return null
+  }
+}
