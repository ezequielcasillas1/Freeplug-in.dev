+// @vitest-environment node
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+/** Round 6 (Aria): /auth/confirm type + next allowlists, open-redirect variants, neutral expired page. */
+const verifyOtp = vi.fn()
+const jarSet = vi.fn()
