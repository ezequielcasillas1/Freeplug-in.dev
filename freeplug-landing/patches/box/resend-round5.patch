+    expect(await visit({ token_hash: 'th_secret_value', type: 'email', next: '/claim' })).toBe('/link-expired?for=claim')
+    expect(await visit({ token_hash: 'th_secret_value', type: 'email' })).toBe('/link-expired?for=account')
