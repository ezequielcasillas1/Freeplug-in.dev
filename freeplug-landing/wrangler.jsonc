// Cloudflare Workers config for Freeplug (Cloudflare port, Oct 3; Aria's card Part A, A9 step 1).
// ONE Worker running the Next.js app through OpenNext (@opennextjs/cloudflare 1.20.8).
//
// Deploy rules (Ezequiel's gates):
//   * Only `npm run upload` (= `wrangler versions upload`): it creates a version with no traffic.
//   * Promoting a version (`wrangler versions deploy <id>`) is GATE 1: Ezequiel's yes at that moment.
//   * Never `wrangler deploy` (it would go live at once). `npm run deploy` refuses on purpose.
//   * Production secrets: `wrangler versions secret put <NAME>` (makes a version, not live).
//     Plain `wrangler secret put` deploys immediately, so it is only for the preview env.
//   * The custom domain (freeplug-in.dev) is NOT configured here: adding it is GATE 2 (DNS).
//     At that gate add: "routes": [{ "pattern": "freeplug-in.dev", "custom_domain": true }]
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freeplug",
  // PLACEHOLDER: Ezequiel's Cloudflare account id goes here before the first `versions upload`.
  // Left invalid on purpose so nothing can upload by accident. Not a secret, but not ours to pick.
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  // custom-worker.ts wraps .open-next/worker.js to add the security headers to every response.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: the Next.js Node runtime (node:crypto, Buffer, streams, net). global_fetch_strictly_public:
  // fetch() can't reach Cloudflare-internal/private addresses (OpenNext's recommended flags).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // OpenNext calls itself through this binding (must match "name").
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "freeplug" }],
  // Cloudflare Images: re-encodes uploaded photos (src/lib/outreach/image-codec-cloudflare.ts)
  // and powers next/image. Free plan: 5,000 unique transformations a month, then error 9422.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  // Workers Paid plan (Ezequiel's decision to buy). Caps runaway CPU per request (Aria A2).
  "limits": { "cpu_ms": 10000 },
  // No second public hostname for production.
  "workers_dev": false,
  "preview_urls": false,
  // Keep Workers Cache OFF (previews send private, no-store; Aria A7).
  "vars": {
    // Trust Cloudflare's CF-Connecting-IP for per-IP rate limits (src/lib/rate-limit/client-ip.ts).
    "TRUST_CF_CONNECTING_IP": "true",
    "ADMIN_ROUTE_ENABLED": "true"
  },
  "env": {
    // Rehearsal Worker on freeplug-preview.<account>.workers.dev with test keys and test data.
    // Put Cloudflare Access in front of it before sharing the URL.
    "preview": {
      "name": "freeplug-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "freeplug-preview" }],
      "images": { "binding": "IMAGES" },
      "vars": { "TRUST_CF_CONNECTING_IP": "true" }
    }
  }
  // Email: Resend becomes the primary sender on Cloudflare once Ezequiel provides a working key
  // (src/lib/email/send.ts sendMail(); RESEND_API_KEY via `versions secret put`). Not switched yet.
}
